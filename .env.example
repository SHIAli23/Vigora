# Copy this file to backend/.env and change the values if needed.

# Database connection. The default is PostgreSQL from docker-compose.yml.
DATABASE_URL=postgresql+psycopg://vigora:vigora@localhost:5432/vigora
# Use this line instead for a quick local run without Docker:
# DATABASE_URL=sqlite:///./vigora.db

# Secret used to sign login tokens. Must be at least 32 characters long.
SECRET_KEY=change-me-to-a-long-random-text-at-least-32-chars

# Fill the database with demo users and data on startup (true or false).
SEED_DEMO_DATA=true

# Web Push: witness questions as notifications when the citizen app is closed.
# Leave empty to turn it off. Generate a key pair in backend/ with: python -m scripts.vapid_keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# A contact address for the push services (mailto: or https:).
VAPID_SUBJECT=mailto:admin@example.com
